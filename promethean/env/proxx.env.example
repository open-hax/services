# Proxx deployment environment schema. Values are examples/placeholders only.
PROXY_AUTH_TOKEN=replace-with-github-environment-secret
POSTGRES_PASSWORD=replace-with-github-environment-secret
SESSION_SECRET=replace-with-github-environment-secret
FEDERATION_DEFAULT_OWNER_SUBJECT=did:web:proxx.promethean.rest
FEDERATION_SELF_CLUSTER_ID=cloud-proxx
FEDERATION_SELF_NODE_ID=proxx-production
FEDERATION_SELF_PUBLIC_BASE_URL=https://proxx.promethean.rest
FEDERATION_BRIDGE_ENABLED=true
PROXX_CONTAINER_UID=1000
PROXX_CONTAINER_GID=1000
PROXX_RUNTIME_DATA_DIR=./runtime-data-v3
PROXX_CONTAINER_HOME=/home/node
PROXX_PM2_HOME=/home/node/.pm2
PROXX_COREPACK_HOME=/home/node/.cache/node/corepack
PROXX_XDG_CACHE_HOME=/home/node/.cache
VITE_ALLOWED_HOSTS=proxx.promethean.rest
