# Proxx production environment contract.
#
# Placeholders only — this file is committed, the rendered .env is not.
# Every value is single-quoted so the result parses identically under
# `docker compose --env-file` and under `.` in the health gate.
#
# REQUESTY_API_KEY is present for verify.sh to register through the Proxx
# credentials API. It is NOT passed to the container: with DATABASE_URL set,
# Proxx ignores environment provider credentials and reads them from Postgres.

PROXX_IMAGE='${OPEN_HAX_SERVICE_IMAGE}'
PROXX_STATE_PATH='${OPEN_HAX_STATE_PATH}'
PROXX_PUBLIC_HOST='proxx.promethean.rest'

PROXY_AUTH_TOKEN='${PROXY_AUTH_TOKEN}'
PROXY_TOKEN_PEPPER='${PROXY_TOKEN_PEPPER}'
PROXX_SESSION_SECRET='${PROXX_SESSION_SECRET}'
PROXX_POSTGRES_PASSWORD='${PROXX_POSTGRES_PASSWORD}'

REQUESTY_API_KEY='${REQUESTY_API_KEY}'
REQUESTY_BASE_URL='https://router.requesty.ai/v1'

# Chat model for the demo. Deliberately the fully-qualified Requesty id rather
# than the gemma4:31b alias: the alias matches :model-family/gemma4, whose
# routing clause pins :prefer/providers-strict? true to
# ["gemini" "ollama-cloud" "ollama"] and would never reach Requesty. The
# qualified id also already contains "/", so Requesty's model-name prefixing
# leaves it alone.
PROXX_DEFAULT_MODEL='google/gemma-4-31b-it'
