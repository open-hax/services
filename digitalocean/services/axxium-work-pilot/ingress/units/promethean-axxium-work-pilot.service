[Unit]
Description=Relay Caddy to the private Axxium Work pilot loopback port
BindsTo=promethean-axxium-work-pilot.socket
After=promethean-axxium-work-pilot.socket

[Service]
ExecStart=/usr/lib/systemd/systemd-socket-proxyd 127.0.0.1:18873
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_UNIX
IPAddressDeny=any
IPAddressAllow=127.0.0.1/32
