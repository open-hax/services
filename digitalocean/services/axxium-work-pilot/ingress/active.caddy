work.pilot.axxium.promethean.rest {
	tls {
		issuer acme
	}

	# OAuth callback parameters must stay out of ingress access logs.
	header {
		>Cache-Control "no-store"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}

	# The app sets same-origin on the mailbox consent form so its POST
	# carries the exact issuer Origin without cross-origin Referer.
	@non_consent_page not {
		method GET
		path_regexp consent ^/oidc/interaction/[^/]+$
	}
	header @non_consent_page >Referrer-Policy "no-referrer"

	@work_surface {
		path /health /portal/* /api/auth/config /api/auth/me /api/auth/logout
		path /api/auth/atproto/start /api/auth/atproto/callback /api/auth/atproto/client-metadata.json
		path /oidc/* /.well-known/oauth-authorization-server/oidc /.well-known/openid-configuration/oidc
		path /.well-known/oauth-protected-resource/api/mailbox/mcp /api/mailbox/mcp
	}
	handle @work_surface {
		request_body {
			max_size 32KiB
		}
		reverse_proxy 172.31.255.1:19073 {
			header_up -x-open-hax-bridge-auth
			transport http {
				dial_timeout 2s
				response_header_timeout 30s
			}
		}
	}
	handle {
		respond 404
	}
	handle_errors 502 503 504 {
		header Cache-Control "no-store"
		respond "Axxium Work pilot unavailable." 503
	}
}
