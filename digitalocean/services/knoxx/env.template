# Knoxx production environment contract.
#
# Placeholders only — this file is committed, the rendered .env is not.
# Every value is single-quoted so the result parses identically under
# `docker compose --env-file` and under `.` in the health gate.

KNOXX_BACKEND_IMAGE='${OPEN_HAX_SERVICE_IMAGE}'
KNOXX_FRONTEND_IMAGE='${KNOXX_FRONTEND_IMAGE}'
KNOXX_STATE_PATH='${OPEN_HAX_STATE_PATH}'
# Durable workspace for folder-backed CMS drafts and Studio media/playlists.
KNOXX_WORKSPACE_PATH='${OPEN_HAX_STATE_PATH}/knoxx-workspace'
KNOXX_PUBLIC_HOST='knoxx.promethean.rest'

KNOXX_API_KEY='${KNOXX_API_KEY}'
# Must match an :actor/email in contracts/knoxx/actors/. Knoxx resolves the
# API-key identity to a membership through those contracts and nothing else, so
# an unlisted address 401s every request as request_context_unresolved.
KNOXX_API_KEY_USER_EMAIL='${KNOXX_API_KEY_USER_EMAIL}'

# Browser login. Both are required: the app treats either one blank as "GitHub
# OAuth off" (routes/auth.cljs github-enabled) and silently serves a UI nobody
# can log into, so compose refuses to start rather than deploy that. The OAuth
# app's Authorization callback URL must be
# https://${KNOXX_PUBLIC_HOST}/api/auth/callback/github.
KNOXX_GITHUB_OAUTH_CLIENT_ID='${KNOXX_GITHUB_OAUTH_CLIENT_ID}'
KNOXX_GITHUB_OAUTH_CLIENT_SECRET='${KNOXX_GITHUB_OAUTH_CLIENT_SECRET}'

# 64 hex characters: the value is read as hex and sliced to a 32-byte AES-GCM
# key. Left unset, the backend invents one per process, so every redeploy or
# container restart silently signs everybody out.
KNOXX_SESSION_SECRET='${KNOXX_SESSION_SECRET}'

MONGODB_URI='${MONGODB_URI}'
MONGODB_DB='openplanner'

# CMS compatibility operations call the production OpenPlanner HTTP service
# through the host gateway. Translation has no REST API dependency.
OPENPLANNER_API_KEY='${OPENPLANNER_API_KEY}'

PROXY_AUTH_TOKEN='${PROXY_AUTH_TOKEN}'
PROXX_DEFAULT_MODEL='google/gemma-4-31b-it'

# gte-large-en-v1.5 is served by DigitalOcean Gradient AI through Proxx and is
# 1024-dimensional. Requesty has no embedding models at all. The dimension is
# effectively permanent: OpenPlanner creates its vector search indexes once and
# never reconciles a changed definition.
EMBED_PROVIDER_MODEL='gte-large-en-v1.5'
EMBED_PROVIDER_DIMENSIONS='1024'
