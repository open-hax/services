# Website environment contract.
#
# Placeholders only — this file is committed, the rendered .env is not. Every
# value is single-quoted so the result parses identically under
# `docker compose --env-file` and under `.` in the health gate.
#
# Only the names deploy-digitalocean.yml exports are substitutable, and a
# placeholder that renders empty fails the deploy rather than shipping a blank.
# This service holds no secrets at all: it serves public bytes.

WEBSITE_IMAGE='${OPEN_HAX_SERVICE_IMAGE}'

# This service has no state of its own. The deploy still creates
# <stateRoot>/website for it; nothing mounts it, and nothing should — the site's
# own copy is compiled into the image and the only durable bytes it serves are
# the content root below, which another service owns.

# Published content, shared with the knoxx service and therefore expressed
# against stateRoot rather than this service's own state directory. Peer of
# state/knoxx and state/website, not a child of either: the writer is knoxx and
# the reader is this service. See docs/published-content-root.md.
WEBSITE_CONTENT_ROOT='${OPEN_HAX_STATE_ROOT}/website-content'

# Music, shared read-only. A peer of state/website-content for the same reason:
# these bytes are state rather than build output, and replacing the image on
# every release must not erase them. Unlike the content root there is no
# in-cluster writer — the library is uploaded out of band from open-hax/calliope,
# so this service is the only thing that touches it, and it touches it :ro.
#
# nginx.conf already carries a `/(graphics|music)/` location with a
# revalidatable cache header, so mounting here is all the serving this needs.
WEBSITE_MUSIC_ROOT='${OPEN_HAX_STATE_ROOT}/website-music'

# The URL prefix the content root is served at. Fixed by the READER, which
# names it in open-hax/website's src/cljc/open_hax/website/domain/published.cljc
# (`content-root`, `manifest-url`, `artifact-url`). The manifest's
# :route/artifact values are relative and resolve against this prefix.
WEBSITE_CONTENT_URL_PREFIX='/published/'

# Declared disk budget for the content root, in MiB. There is no filesystem
# quota; verify.sh WARNs past this and the sweep is manual. See
# docs/published-content-root.md §5.
WEBSITE_CONTENT_BUDGET_MB='2048'

# Loopback publication. 8080 is knoxx-frontend, 8789 is proxx, 9000 is smoke,
# and caddy alone owns 80/443.
WEBSITE_LOOPBACK_PORT='8081'

# Carried over from services#19. The record already resolves to this droplet, so
# verify.sh asserts TLS here rather than warning; what is still missing is the
# certificate, which issues once the caddy site block deploys.
WEBSITE_PUBLIC_HOST='open-hax.promethean.rest'

# This host's declared public address, used to decide whether the public
# hostname resolves here yet. A DNS answer pointing elsewhere means the TLS
# probe would be testing another machine.
WEBSITE_HOST_ADDRESS='${OPEN_HAX_HOST_ADDRESS}'
