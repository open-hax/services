# Variable-name contract only. The bounded Axxium production transaction uses
# the incumbent host-owned .env and verifies its digest; it NEVER renders or
# sources this template. The generic renderer must reject service axxium.
# No production value or replacement credential belongs in this file.

AXXIUM_IMAGE='${OPEN_HAX_SERVICE_IMAGE}'
AXXIUM_STATE_PATH='${OPEN_HAX_STATE_PATH}'
AXXIUM_PUBLIC_HOST='axxium.promethean.rest'
# Preserved only in the incumbent private .env, never supplied by a renderer:
# AXXIUM_DB_PASSWORD
# AXXIUM_JWT_SECRET
# AXXIUM_BOOTSTRAP_ADMIN_EMAIL
# PDS_JWT_SECRET
# PDS_ADMIN_PASSWORD
# PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX

# Candidate-only overlay values are fixed and verified by the transaction.
# The OIDC directory is a read-only bind with create_host_path:false there.
AXXIUM_OIDC_CONFIG_FILE='/run/axxium/oidc/authority.json'
AXXIUM_TRUST_PROXY='172.18.0.9'
