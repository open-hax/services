;; Which authentication methods the MCP Streamable HTTP surface accepts.
;;
;; The production verifier runs inside the backend container. Its bearer is
;; accepted only from loopback and resolves the dedicated deploy_verifier
;; actor, whose role exposes exactly the three read-only tools in
;; :cap/deploy-verify. The method is inert without the separately provisioned
;; KNOXX_MCP_LOOPBACK_TOKEN secret.
{:contract/kind :authentication
 :contract/id "mcp_http"
 :contract/doc "Authentication methods accepted by POST /mcp."
 :auth/surface :mcp

 :auth/methods
 [{:auth-method/id :oauth-bearer
   :auth-method/enabled true
   :auth-method/doc
   "A token minted through /api/mcp/oauth/authorize and its consent page."}

  {:auth-method/id :trusted-loopback
   :auth-method/enabled true
   :auth-method/doc
   "The production post-deploy MCP verifier. Inert unless the loopback token is provisioned."
   :auth-method/require-loopback true
   :auth-method/require-non-production false
   :auth-method/token-env "KNOXX_MCP_LOOPBACK_TOKEN"
   :auth-method/min-token-length 16
   :auth-method/grants
   {:grant/user-email "deploy-verifier@open-hax.local"
    :grant/actor-id "deploy_verifier"
    :grant/tools :all}}]}
